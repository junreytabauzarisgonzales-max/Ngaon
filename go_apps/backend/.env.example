# Address the phones use to reach this machine (LAN IP or tunnel URL).
PUBLIC_URL=http://192.168.x.x:8080
# Change for anything beyond local testing.
JWT_SECRET=change-me
ADMIN_TOKEN=change-me
# Dev conveniences (no SMS / KYC provider yet). Unset in production.
DEV_OTP_CODE=123456
AUTO_APPROVE_RIDERS_SECONDS=8
RIDER_START_BALANCE=20000
# Testing outside Bongao: accept any location and dispatch to riders at any distance.
DEV_ANY_LOCATION=false
MAX_DISPATCH_M=15000

# ---------------- Google Maps Platform (server key) ----------------
# Enable: Routes API, Geocoding API, Places API (New). Restrict the key to this server's IP.
# Empty = straight-line pricing and the built-in Bongao landmark list.
GOOGLE_MAPS_API_KEY=
# TWO_WHEELER (motorcycle, beta) falls back to DRIVE automatically where unsupported.
GOOGLE_ROUTES_TRAVEL_MODE=TWO_WHEELER

# ---------------- Didit identity verification (rider KYC) ----------------
# business.didit.me -> your application -> Developers -> API keys (sk_test_… sandbox / sk_live_…).
# Empty = no KYC step; riders are approved by AUTO_APPROVE_RIDERS_SECONDS or /admin.
DIDIT_API_KEY=
# Workflow (ID document + liveness) from the Didit console.
DIDIT_WORKFLOW_ID=
# API & Webhooks -> destination secret. Webhook URL: ${PUBLIC_URL}/webhooks/didit (must be public HTTPS).
DIDIT_WEBHOOK_SECRET=
DIDIT_BASE_URL=https://verification.didit.me

# ---------------- PayMongo (GCash / Maya checkout, refunds) ----------------
# Dashboard -> Developers -> API keys (sk_test_… / sk_live_…).
# Empty = built-in dev payment page with Pay / Fail buttons.
PAYMONGO_SECRET_KEY=
# Developers -> Webhooks -> add ${PUBLIC_URL}/webhooks/paymongo with event checkout_session.payment.paid
# (public HTTPS domain required). Without it the backend polls PayMongo while the app waits.
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_BASE_URL=https://api.paymongo.com
