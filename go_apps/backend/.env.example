# Address the phones use to reach this machine (LAN IP or tunnel URL).
PUBLIC_URL=http://192.168.x.x:8080
# Change for anything beyond local testing.
JWT_SECRET=change-me
ADMIN_TOKEN=change-me
# Dev conveniences (no SMS / KYC provider yet). Unset in production.
DEV_OTP_CODE=123456
AUTO_APPROVE_RIDERS_SECONDS=8
RIDER_START_BALANCE=20000
# Testing outside Bongao: accept any location and dispatch to riders at any distance.
DEV_ANY_LOCATION=false
MAX_DISPATCH_M=15000
