# Address the phones use to reach this machine (LAN IP or tunnel URL).
PUBLIC_URL=http://192.168.x.x:8080
# Change for anything beyond local testing.
JWT_SECRET=change-me
ADMIN_TOKEN=change-me
# Dev conveniences (no SMS / KYC provider yet). Unset in production.
DEV_OTP_CODE=123456
AUTO_APPROVE_RIDERS_SECONDS=8
RIDER_START_BALANCE=20000
# Testing outside Bongao: accept any location and dispatch to riders at any distance.
DEV_ANY_LOCATION=false
MAX_DISPATCH_M=15000

# Security & Rate Limiting
CORS_ALLOWED_ORIGINS=*
TRUSTED_PROXIES=
RATE_LIMIT_PER_MIN=300
AUTH_RATE_LIMIT_PER_MIN=30

# PostgreSQL database configuration
POSTGRES_USER=goapp
POSTGRES_PASSWORD=goapp_secret
POSTGRES_DB=go_delivery
POSTGRES_PORT=5433
# Connection URL used by the Go API
DATABASE_URL=postgres://goapp:goapp_secret@postgres:5432/go_delivery?sslmode=disable

# Redis configuration (caching, sessions, rate limiting, geospatial, pub/sub)
REDIS_PASSWORD=goapp_redis_secret
REDIS_PORT=6379
REDIS_URL=redis://:goapp_redis_secret@redis:6379/0
